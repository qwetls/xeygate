{
    "name": "xeygate",
    "version": "1.0.0",
    "description": "XEYGATE — Cloud-first multi-provider AI Gateway and LLM proxy router",
    "author": "XeyCompany Group",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/XeyCompany/xeygate.git"
    },
    "keywords": [
        "ai-gateway",
        "llm-proxy",
        "openai-compatible",
        "anthropic-compatible",
        "hono",
        "sqlite",
        "xeygate",
        "claude",
        "gpt",
        "gemini"
    ],
    "homepage": "https://github.com/XeyCompany/xeygate#readme",
    "bugs": {
        "url": "https://github.com/XeyCompany/xeygate/issues"
    },
    "scripts": {
        "dev": "turbo dev",
        "start": "turbo start",
        "build": "turbo build",
        "clean": "turbo clean || rm -rf apps/*/dist packages/*/dist .turbo",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "turbo lint",
        "test": "turbo test",
        "xeygate": "pnpm --filter @xeygate/cli exec tsx src/index.ts"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
    "dependencies": {
        "@xyflow/system": "^0.0.80",
        "turbo": "^2.10.12"
    },
    "devDependencies": {
        "prettier": "^3.5.0",
        "typescript": "^5.0.0"
    }
}
