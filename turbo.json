{
    "$schema": "https://v2-10-12.turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"],
            "outputLogs": "new-only"
        },
        "start": {
            "cache": false,
            "persistent": true,
            "dependsOn": ["^build"],
            "outputLogs": "new-only"
        },
        "lint": {},
        "clean": {
            "cache": false
        },
        "test": {
            "dependsOn": ["^build"]
        }
    }
}
