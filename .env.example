# =============================================================================
# XEYGATE Environment Configuration
# =============================================================================

# API Gateway & Web Dashboard Port (Default: 3000)
PORT=3000

# OAuth Callback Listener Port (Default: 1455)
OAUTH_PORT=1455

# Database (PostgreSQL for cloud deployment)
# DATABASE_URL=postgresql://user:pass@host:5432/xeygate

# SQLite Database Location (local dev only)
# - Default: ~/.xeygate/xeygate.db (in your home directory)
# - For Docker: DATABASE_PATH=/app/data/xeygate.db
DATABASE_PATH=~/.xeygate/xeygate.db

# Path to built web dashboard static files (optional, defaults to apps/web/dist)
# WEB_DIST_PATH=apps/web/dist

# Node Environment (development | production)
NODE_ENV=development

# Cloud mode (set to true for hosted deployment)
# CLOUD_MODE=true

# JWT secret for user auth (required in cloud mode)
# Also used as the data key for encrypting provider credentials at rest unless
# XEYGATE_ENCRYPTION_KEY is set. In Docker this file must be named .env in the
# compose directory — docker-compose.yml loads it via env_file.
# JWT_SECRET=your-secret-key-here

# Encryption key for provider credentials at rest (falls back to JWT_SECRET)
# XEYGATE_ENCRYPTION_KEY=your-key-here

# Admin bootstrap / recovery: when the password is set, every boot ensures this
# account exists, is an admin, and has this password.
# SROUTER_ADMIN_EMAIL=admin@xeycompany.com
# SROUTER_ADMIN_PASSWORD=change-me

# Session/cookie and origin hardening for public HTTPS deployments
# SROUTER_SECURE_COOKIES=true
# SROUTER_CORS_ORIGINS=https://xeycompany.com
# SROUTER_PUBLIC_URL=https://xeygate.xeycompany.com

# Base URL for public access
# PUBLIC_URL=https://xeygate.xeycompany.com
