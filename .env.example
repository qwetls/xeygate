# =============================================================================
# SRouter Environment Configuration
# =============================================================================

# API Gateway & Web Dashboard Port (Default: 3000)
PORT=3000

# OAuth Callback Listener Port (Default: 1455)
OAUTH_PORT=1455

# SQLite Database Location
# - Default: ~/.srouter/srouter.db (in your home directory)
# - For Local Dev: override with DATABASE_PATH=/custom/path/srouter.db
# - For Docker: DATABASE_PATH=/app/data/srouter.db
# 
# The default location uses a dedicated folder in your user's home directory.
# This keeps your project clean and makes database backups easier.
DATABASE_PATH=~/.srouter/srouter.db

# Path to built web dashboard static files (optional, defaults to apps/web/dist)
# WEB_DIST_PATH=apps/web/dist

# Node Environment (development | production)
NODE_ENV=development
