# =============================================================================
# XEYGATE Environment Configuration
# =============================================================================

# API Gateway & Web Dashboard Port (Default: 3000)
PORT=3000

# OAuth Callback Listener Port (Default: 1455)
OAUTH_PORT=1455

# Database (PostgreSQL for cloud deployment)
# DATABASE_URL=postgresql://user:pass@host:5432/xeygate

# SQLite Database Location (local dev only)
# - Default: ~/.xeygate/xeygate.db (in your home directory)
# - For Docker: DATABASE_PATH=/app/data/xeygate.db
DATABASE_PATH=~/.xeygate/xeygate.db

# Path to built web dashboard static files (optional, defaults to apps/web/dist)
# WEB_DIST_PATH=apps/web/dist

# Node Environment (development | production)
NODE_ENV=development

# Cloud mode (set to true for hosted deployment)
# CLOUD_MODE=true

# JWT secret for user auth (required in cloud mode)
# JWT_SECRET=your-secret-key-here

# Base URL for public access
# PUBLIC_URL=https://xeygate.xeycompany.com
